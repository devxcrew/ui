{
  "name": "@devxcrew/react-ui",
  "version": "0.2.0",
  "type": "module",
  "exports": {
    "./hooks/*": "./src/hooks/*.ts",
    "./features/*": "./src/features/*/index.ts",
    ".": "./src/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./blocks/*": "./src/blocks/*/index.ts",
    "./layouts/*": "./src/layouts/*/index.ts",
    "./theme": "./src/theme/index.ts",
    "./lib/*": "./src/lib/*.ts",
    "./tokens": "./src/tokens/index.ts",
    "./styles": "./src/styles/globals.css",
    "./design-system": "./src/design-system/index.ts",
    "./templates/*": "./src/templates/*/index.ts"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tabler/icons-react": "3.48.0",
    "@tanstack/react-table": "^9.1.2",
    "@tiptap/core": "^3.30.2",
    "@tiptap/extension-color": "^3.30.2",
    "@tiptap/extension-highlight": "^3.30.2",
    "@tiptap/extension-image": "^3.30.2",
    "@tiptap/extension-link": "^3.30.2",
    "@tiptap/extension-mention": "^3.30.2",
    "@tiptap/extension-placeholder": "^3.30.2",
    "@tiptap/extension-subscript": "^3.30.2",
    "@tiptap/extension-superscript": "^3.30.2",
    "@tiptap/extension-task-item": "^3.30.2",
    "@tiptap/extension-task-list": "^3.30.2",
    "@tiptap/extension-text-align": "^3.30.2",
    "@tiptap/extension-text-style": "^3.30.2",
    "@tiptap/extension-underline": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "@tiptap/suggestion": "^3.30.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^13.1.0",
    "input-otp": "^1.5.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.33.0",
    "mermaid": "12.1.0",
    "react-day-picker": "^10.0.1",
    "react-is": "^19.3.0",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "^4.12.3",
    "recharts": "^3.10.1",
    "remark-gfm": "4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@devxcrew/tools": "0.1.7",
    "@types/node": "^26.6.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devxcrew/ui.git"
  },
  "scripts": {
    "github:now": "devxcrew-tools github:now",
    "version:update": "devxcrew-tools version:bump",
    "fix:line-endings": "devxcrew-tools lines:fix",
    "check:versions": "devxcrew-tools check:versions",
    "version:show": "devxcrew-tools version:show",
    "version:bump": "devxcrew-tools version:bump",
    "changelog:append": "devxcrew-tools changelog:append",
    "changelog:show": "devxcrew-tools changelog:show",
    "tools:lines:fix": "devxcrew-tools lines:fix",
    "lines:check": "devxcrew-tools lines:check",
    "tools:check": "devxcrew-tools dependencies:order && devxcrew-tools check:versions && devxcrew-tools lines:check",
    "check": "npm run tools:check",
    "mcp:connect": "node agent/connect.mjs",
    "mcp:verify": "node agent/connect.mjs --strict",
    "version-bump": "devxcrew-tools version:bump",
    "prepublishOnly": "npm run release:check",
    "release:check": "npm run check && npm run typecheck && npm run check:exports && npm test && npm pack --dry-run --ignore-scripts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "check:exports": "node tools/check-exports.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "src",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ]
}
